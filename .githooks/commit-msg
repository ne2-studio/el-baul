#!/usr/bin/env bash
set -Eeuo pipefail

commit_msg_file="${1:-}"

if [[ -z "$commit_msg_file" || ! -f "$commit_msg_file" ]]; then
  printf 'commit-msg: cannot read commit message file\n' >&2
  exit 1
fi

header="$(
  sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p; q' "$commit_msg_file"
)"

if [[ "$header" =~ ^Merge\  ]]; then
  exit 0
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([[:alnum:]._-]+\))?!?: [^[:space:]].*$'

if [[ "$header" =~ $pattern ]]; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message.

Use Conventional Commits:
  <type>[optional scope]: <description>

Allowed types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test

Examples:
  feat(app): add photo upload
  fix(api): handle missing user claims
  docs: update local development guide
  refactor!: rename baul routes
EOF

exit 1
