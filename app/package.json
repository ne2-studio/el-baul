{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && sentry-cli sourcemaps inject --ignore 'env-config*.js' dist",
    "dev": "VITE_OIDC_CALLBACK_URI=http://localhost:5173/callback vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "android:build": "vite build --mode android && cap sync android",
    "sentry:upload-sourcemaps": "sentry-cli sourcemaps upload --org pedro-pardal --project el-baul dist",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "vitest --project=storybook --run --maxWorkers=1",
    "test:acceptance": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@sentry/capacitor": "^4.2.0",
    "@sentry/react": "10.60.0",
    "clsx": "2.1.1",
    "heic-to": "^1.5.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "oidc-client-ts": "^3.3.0",
    "react-oidc-context": "^3.2.0",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@sentry/cli": "^2.58.6",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "storybook": "^10.5.2",
    "tailwindcss": "4.1.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0",
      "minimatch": "10.2.5"
    },
    "jake": "12.10.1"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "allowScripts": {
    "@sentry/capacitor@4.2.0": true,
    "@sentry/cli@2.58.6": true,
    "@tailwindcss/oxide@4.1.12": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
