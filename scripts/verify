#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_ID="$(date -u +%Y%m%d%H%M%S)-$$"

created_images=()
build_images=1

usage() {
  cat <<'EOF'
Usage: ./scripts/verify [options] <command>

Options:
  --build-images       Build images needed by acceptance commands. Default.
  --skip-image-build   Reuse already-built images for acceptance commands.

Commands:
  backend               Build and test the .NET backend solution in Release.
  backend-acceptance    Run acceptance-tests against the real backend image.
  frontend              Run app type checks, a production build, unit/component tests, and Storybook specs.
  admin                 Run admin type checks and unit/component tests.
  frontend-acceptance   Run app Playwright E2E against app + api-lite images.
  admin-acceptance      Run admin Playwright E2E against admin + api-lite images.
  e2e                   Run whole-stack smoke tests against docker-compose.yaml.
  all                   Run every verification above.

Environment:
  BACKEND_IMAGE          Tag for backend-acceptance. Defaults to el-baul-api:verify-<run>.
  APP_IMAGE              Tag for frontend-acceptance app image. Defaults to el-baul-app:verify-<run>.
  ADMIN_IMAGE            Tag for admin-acceptance admin image. Defaults to el-baul-admin:verify-<run>.
  API_LITE_IMAGE         Tag for frontend/admin acceptance lite API image. Defaults to el-baul-api-lite:verify-<run>.
  KEEP_VERIFY_IMAGES=1   Keep images built by this script.
  VERIFY_COVERAGE=1      Run coverage variants for fast unit checks.
  VERIFY_NPM_CI=1        Force npm ci before Node checks.
EOF
}

log() {
  printf '\n==> %s\n' "$*"
}

die() {
  printf 'verify: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

port_in_use() {
  local port="$1"

  if docker ps --format '{{.Names}} {{.Ports}}' | grep -Eq "(^|[ ,])([0-9.]+:|\\[::\\]:)?$port->"; then
    return 0
  fi

  if command -v ss >/dev/null 2>&1 && ss -ltn | awk '{print $4}' | grep -Eq "(:|\\])$port$"; then
    return 0
  fi

  return 1
}

require_ports_available() {
  local port
  for port in "$@"; do
    if port_in_use "$port"; then
      die "port $port is already in use; stop the conflicting service before running this verification"
    fi
  done
}

run() {
  log "$*"
  "$@"
}

run_in() {
  local dir="$1"
  shift
  log "($dir) $*"
  (cd "$ROOT_DIR/$dir" && "$@")
}

ensure_root() {
  [[ -f "$ROOT_DIR/docker-compose.yaml" ]] || die "cannot locate repo root"
  [[ -f "$ROOT_DIR/api/ElBaul.slnx" ]] || die "cannot locate backend solution"
  [[ -f "$ROOT_DIR/app/package.json" ]] || die "cannot locate app package"
}

ensure_npm_deps() {
  local dir="$1"
  local node_modules="$ROOT_DIR/$dir/node_modules"
  local hidden_lock="$node_modules/.package-lock.json"

  if [[ "${VERIFY_NPM_CI:-}" == "1" || ! -d "$node_modules" || ! -f "$hidden_lock" || "$ROOT_DIR/$dir/package-lock.json" -nt "$hidden_lock" ]]; then
    run_in "$dir" npm ci
  fi
}

docker_build_fresh() {
  local tag="$1"
  shift

  need docker
  log "Removing any existing local tag $tag"
  docker image rm -f "$tag" >/dev/null 2>&1 || true

  run docker build -t "$tag" "$@"
  created_images+=("$tag")
}

require_image() {
  local tag="$1"

  need docker
  docker image inspect "$tag" >/dev/null 2>&1 || die "required image not found: $tag; build it first or omit --skip-image-build"
}

cleanup() {
  local status=$?
  set +e

  if [[ "${KEEP_VERIFY_IMAGES:-}" != "1" && ${#created_images[@]} -gt 0 ]]; then
    for image in "${created_images[@]}"; do
      log "Removing verification image $image"
      docker image rm -f "$image" >/dev/null 2>&1 || true
    done
  fi

  exit "$status"
}
trap cleanup EXIT

backend() {
  need dotnet
  run dotnet restore "$ROOT_DIR/api/ElBaul.slnx"
  run dotnet build "$ROOT_DIR/api/ElBaul.slnx" --configuration Release --no-restore

  if [[ "${VERIFY_COVERAGE:-}" == "1" ]]; then
    run dotnet test "$ROOT_DIR/api/ElBaul.slnx" --configuration Release --no-build --collect:"XPlat Code Coverage" --results-directory "$ROOT_DIR/api/coverage"
  else
    run dotnet test "$ROOT_DIR/api/ElBaul.slnx" --configuration Release --no-build
  fi
}

backend_acceptance() {
  need dotnet
  need docker
  local image="${BACKEND_IMAGE:-el-baul-api:verify-$RUN_ID}"

  if [[ "$build_images" == "1" ]]; then
    docker_build_fresh "$image" "$ROOT_DIR/api"
  else
    require_image "$image"
  fi

  run env BACKEND_IMAGE="$image" dotnet test "$ROOT_DIR/api/acceptance-tests/ElBaul.AcceptanceTests.slnx"
}

frontend_unit_package() {
  local dir="$1"
  local typecheck_script="$2"

  ensure_npm_deps "$dir"
  run_in "$dir" npm run "$typecheck_script"

  if [[ "${VERIFY_COVERAGE:-}" == "1" ]]; then
    run_in "$dir" npm run test:coverage
    write_node_coverage_summary "$dir"
  else
    run_in "$dir" npm test
  fi
}

write_node_coverage_summary() {
  local dir="$1"

  run_in "$dir" node <<'NODE'
const fs = require('node:fs');
const { createCoverageMap } = require('istanbul-lib-coverage');

const finalCoveragePath = 'coverage/coverage-final.json';
const jsonSummaryPath = 'coverage/coverage-summary.json';
const summaryPath = 'coverage/summary.txt';

if (fs.existsSync(summaryPath)) {
  process.exit(0);
}

let total;
if (fs.existsSync(jsonSummaryPath)) {
  total = JSON.parse(fs.readFileSync(jsonSummaryPath, 'utf8')).total;
} else if (fs.existsSync(finalCoveragePath)) {
  const coverage = createCoverageMap(JSON.parse(fs.readFileSync(finalCoveragePath, 'utf8')));
  total = coverage.getCoverageSummary().toJSON();
} else {
  throw new Error(`Cannot write ${summaryPath}: missing ${jsonSummaryPath} and ${finalCoveragePath}`);
}

function line(label, key) {
  const metric = total[key];
  return `${label.padEnd(12)}: ${String(metric.pct).padStart(6)}% ( ${metric.covered}/${metric.total} )`;
}

fs.mkdirSync('coverage', { recursive: true });
fs.writeFileSync(
  summaryPath,
  [
    'Coverage summary from v8',
    line('Statements', 'statements'),
    line('Branches', 'branches'),
    line('Functions', 'functions'),
    line('Lines', 'lines'),
    '',
  ].join('\n')
);
NODE
}

frontend() {
  need npm
  ensure_npm_deps app
  run_in app npm run typecheck
  run_in app npm run build

  if [[ "${VERIFY_COVERAGE:-}" == "1" ]]; then
    run_in app npm run test:coverage
    write_node_coverage_summary app
  else
    run_in app npm test
  fi

  run_in app npx playwright install chromium
  run_in app npm run test:storybook
}

admin() {
  need npm
  frontend_unit_package admin lint
}

frontend_acceptance() {
  need npm
  need docker
  local app_image="${APP_IMAGE:-el-baul-app:verify-$RUN_ID}"
  local api_lite_image="${API_LITE_IMAGE:-el-baul-api-lite:verify-$RUN_ID}"

  ensure_npm_deps app
  run docker compose --profile admin -f "$ROOT_DIR/docker-compose.lite.yml" down -v --remove-orphans
  require_ports_available 3000 5000 5051

  if [[ "$build_images" == "1" ]]; then
    docker_build_fresh "$app_image" "$ROOT_DIR/app"
    docker_build_fresh "$api_lite_image" -f "$ROOT_DIR/api/ElBaul.Api.Lite/Dockerfile" "$ROOT_DIR/api"
  else
    require_image "$app_image"
    require_image "$api_lite_image"
  fi

  run_in app npx playwright install chromium
  run_in app env APP_IMAGE="$app_image" API_LITE_IMAGE="$api_lite_image" npm run test:acceptance
}

admin_acceptance() {
  need npm
  need docker
  local admin_image="${ADMIN_IMAGE:-el-baul-admin:verify-$RUN_ID}"
  local api_lite_image="${API_LITE_IMAGE:-el-baul-api-lite:verify-$RUN_ID}"

  ensure_npm_deps admin
  run docker compose --profile admin -f "$ROOT_DIR/docker-compose.lite.yml" down -v --remove-orphans
  require_ports_available 3001 5000 5051

  if [[ "$build_images" == "1" ]]; then
    docker_build_fresh "$admin_image" "$ROOT_DIR/admin"
    docker_build_fresh "$api_lite_image" -f "$ROOT_DIR/api/ElBaul.Api.Lite/Dockerfile" "$ROOT_DIR/api"
  else
    require_image "$admin_image"
    require_image "$api_lite_image"
  fi

  run_in admin npx playwright install chromium
  run_in admin env ADMIN_IMAGE="$admin_image" API_LITE_IMAGE="$api_lite_image" npm run test:acceptance
}

e2e() {
  need npm
  need docker

  ensure_npm_deps e2e-tests
  run_in e2e-tests npx playwright install chromium
  run_in e2e-tests npm run typecheck
  run_in e2e-tests npm run test:e2e
}

all() {
  backend
  backend_acceptance
  frontend
  admin
  frontend_acceptance
  admin_acceptance
  e2e
}

ensure_root

command=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --build-images|--rebuild-images)
      build_images=1
      shift
      ;;
    --skip-image-build|--no-image-build)
      build_images=0
      shift
      ;;
    --)
      shift
      if [[ $# -gt 0 ]]; then
        command="$1"
        shift
      fi
      break
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      die "unknown option: $1"
      ;;
    *)
      command="$1"
      shift
      break
      ;;
  esac
done

[[ $# -eq 0 ]] || die "unexpected argument: $1"

case "$command" in
  backend) backend ;;
  backend-acceptance) backend_acceptance ;;
  frontend) frontend ;;
  admin) admin ;;
  frontend-acceptance) frontend_acceptance ;;
  admin-acceptance) admin_acceptance ;;
  e2e) e2e ;;
  all) all ;;
  "") usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
