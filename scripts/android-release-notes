#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHANGELOG="$ROOT_DIR/CHANGELOG.md"

usage() {
  cat <<'EOF'
Usage: ./scripts/android-release-notes <tag>

Extracts one version's release notes out of CHANGELOG.md, for use as the
Android (Firebase App Distribution) release notes in CI — see
android-beta.yml.

  <tag>          The exact CHANGELOG heading to extract, e.g. "beta-v0.1.3" —
                 must match a "## [<tag>]" section verbatim, including the
                 "beta-v" prefix (CHANGELOG.md's tagged sections carry a
                 trailing " - <date>" that this matches as a prefix, so the
                 date doesn't need to be passed in).
  "unreleased"   Extracts "## [No publicado]" instead, for builds that
                 aren't cut from a tagged release (workflow_dispatch, or any
                 future push-to-main build).

Fails loudly if the requested section isn't found or is empty — for a
tagged release this means CHANGELOG.md's "[No publicado]" section wasn't
renamed to the tag being released yet, which the update-changelog skill
says must happen as part of cutting the tag.
EOF
}

if [[ $# -ne 1 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 1
fi

TAG="$1"
if [[ "$TAG" == "unreleased" ]]; then
  HEADING="## [No publicado]"
else
  HEADING="## [$TAG]"
fi

NOTES="$(awk -v heading="$HEADING" '
  index($0, heading) == 1 { found=1; next }
  found && index($0, "## ") == 1 { exit }
  found { print }
' "$CHANGELOG" | awk 'NF{p=1} p' | tac | awk 'NF{p=1} p' | tac)"

if [[ -z "$NOTES" ]]; then
  echo "error: no non-empty CHANGELOG.md section found for '$HEADING'" >&2
  echo "if this is a tagged release, rename '## [No publicado]' to '$HEADING' in CHANGELOG.md first (see the update-changelog skill)." >&2
  exit 1
fi

printf '%s\n' "$NOTES"
