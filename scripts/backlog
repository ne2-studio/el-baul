#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKLOG_DIR="$ROOT_DIR/.backlog"
QUEUE_DIR="$BACKLOG_DIR/queue"
DONE_DIR="$BACKLOG_DIR/done"
FAILED_DIR="$BACKLOG_DIR/failed"
SIGNAL_FILE="$BACKLOG_DIR/.signal"
TMUX_SESSION="backlog"

usage() {
  cat <<'EOF'
Usage: ./scripts/backlog <command>

Commands:
  add [file]     Add a ticket to the queue. Reads from <file> if given, else
                  from stdin. First line becomes the slug.
  list            List queued/done/failed tickets.
  run             Start the orchestrator (tmux session with a worker pane
                  and a watcher pane) and attach to it. Safe to detach
                  (Ctrl-b d) and reattach later with:
                    tmux attach -t backlog
  stop            Kill the orchestrator tmux session.

Each ticket runs in its own fresh `claude` session (the work-ticket skill).
git commit/push are not in the permission allow-list, so they always prompt
for approval — forward it to your phone with Remote Control (/rc) before
running `run`.
EOF
}

ensure_dirs() {
  mkdir -p "$QUEUE_DIR" "$DONE_DIR" "$FAILED_DIR"
}

slugify() {
  iconv -t ascii//TRANSLIT 2>/dev/null <<<"$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' \
    | cut -c1-50
}

cmd_add() {
  ensure_dirs
  local content
  if [[ "${1:-}" ]]; then
    content="$(cat "$1")"
  else
    content="$(cat)"
  fi
  [[ -n "$content" ]] || { echo "Ticket vacío, no se ha añadido." >&2; exit 1; }

  local title slug next n file
  title="$(head -n1 <<<"$content" | sed -E 's/^#+\s*//')"
  slug="$(slugify "$title")"
  [[ -n "$slug" ]] || slug="ticket"
  next=1
  for f in "$QUEUE_DIR"/*.md "$DONE_DIR"/*.md "$FAILED_DIR"/*.md; do
    [[ -e "$f" ]] || continue
    n="$(basename "$f" | grep -oE '^[0-9]+' || true)"
    [[ -n "$n" ]] && (( 10#$n >= next )) && next=$(( 10#$n + 1 ))
  done
  file="$QUEUE_DIR/$(printf '%03d' "$next")-$slug.md"
  printf '%s\n' "$content" > "$file"
  echo "Añadido: $file"
}

cmd_list() {
  ensure_dirs
  echo "En cola:"
  ls -1 "$QUEUE_DIR" 2>/dev/null | sed 's/^/  /' || true
  echo "Hechos:"
  ls -1 "$DONE_DIR" 2>/dev/null | sed 's/^/  /' || true
  echo "Fallidos/bloqueados:"
  ls -1 "$FAILED_DIR" 2>/dev/null | sed 's/^/  /' || true
}

# Runs inside the worker tmux pane. Processes the queue sequentially.
_worker() {
  ensure_dirs
  cd "$ROOT_DIR"
  shopt -s nullglob
  local files=("$QUEUE_DIR"/*.md)
  if (( ${#files[@]} == 0 )); then
    echo "Backlog vacío."
    return 0
  fi
  for file in "${files[@]}"; do
    rm -f "$SIGNAL_FILE"
    echo
    echo "=================================================="
    echo "Ticket: $(basename "$file")"
    echo "=================================================="
    local prompt
    prompt="$(printf '/work-ticket\n\nTicket file: %s\n\n%s' "$file" "$(cat "$file")")"
    claude "$prompt" || true

    if [[ -f "$SIGNAL_FILE" ]]; then
      local status
      status="$(sed -n 's/^status=//p' "$SIGNAL_FILE" | head -n1)"
      case "$status" in
        done)
          mv "$file" "$DONE_DIR/"
          echo "-> hecho: $(basename "$file")"
          ;;
        blocked)
          mv "$file" "$FAILED_DIR/"
          echo "-> bloqueado: $(basename "$file"). Revisa y vuelve a encolar si procede."
          ;;
        *)
          echo "-> señal desconocida ('$status'), dejo el ticket en cola para revisión manual."
          break
          ;;
      esac
      rm -f "$SIGNAL_FILE"
    else
      echo "-> la sesión terminó sin señal (salida manual/crash). Dejo el ticket en cola y paro."
      break
    fi
  done
  echo
  echo "Cola procesada. Quedan: ${#files[@]} tickets vistos."
}

# Runs inside the watcher tmux pane. Injects /exit into the worker pane once
# the skill signals it has finished, since a session can't end itself.
_watcher() {
  while true; do
    if [[ -f "$SIGNAL_FILE" ]]; then
      sleep 1
      tmux send-keys -t "${TMUX_SESSION}:0.0" "/exit" Enter
      while [[ -f "$SIGNAL_FILE" ]]; do sleep 1; done
    fi
    sleep 2
  done
}

cmd_run() {
  ensure_dirs
  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "Ya hay una sesión '$TMUX_SESSION' corriendo. Conectando..."
    exec tmux attach -t "$TMUX_SESSION"
  fi
  tmux new-session -d -s "$TMUX_SESSION" -n main "$0 __worker"
  tmux split-window -t "${TMUX_SESSION}:0" -v -l 3 "$0 __watcher"
  tmux select-pane -t "${TMUX_SESSION}:0.0"
  echo "Orquestador arrancado en tmux '$TMUX_SESSION'."
  echo "Recuerda tener /rc activo en la sesión de Claude para aprobar commit/push desde el móvil."
  exec tmux attach -t "$TMUX_SESSION"
}

cmd_stop() {
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null && echo "Sesión '$TMUX_SESSION' detenida." || echo "No había sesión corriendo."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  list) cmd_list ;;
  run) cmd_run ;;
  stop) cmd_stop ;;
  __worker) _worker ;;
  __watcher) _watcher ;;
  -h|--help|"") usage ;;
  *) echo "Comando desconocido: $1" >&2; usage; exit 1 ;;
esac
