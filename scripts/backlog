#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
BACKLOG_DIR="$ROOT_DIR/.backlog"
SIGNAL_FILE="$BACKLOG_DIR/.signal"
TMUX_SESSION="backlog"
QUEUE_LABEL="backlog"
FAILED_LABEL="backlog:failed"

usage() {
  cat <<'EOF'
Usage: ./scripts/backlog <command>

Commands:
  add [file]        Create a GitHub issue and add it to the queue (label
                      "backlog"). Reads from <file> if given, else from
                      stdin. First line becomes the issue title.
  list               List queued/done/failed tickets (GitHub issues).
  requeue <number>   Move a failed/blocked issue back into the queue.
  run [--yolo]       Start the orchestrator (tmux session with a worker pane
                      and a watcher pane) and attach to it. The worker polls
                      the queue every 30s (BACKLOG_POLL_INTERVAL to override)
                      and keeps running, picking up new issues as they're
                      labeled "backlog" — no need to restart it per ticket.
                      Safe to detach (Ctrl-b d) and reattach later with:
                        tmux attach -t backlog
                      --yolo runs claude with --dangerously-skip-permissions:
                      no prompts at all, including git commit/push. Only use it
                      when you're comfortable leaving it fully unattended.
  stop               Kill the orchestrator tmux session.

The worker stops polling (leaving the tmux session up) if a ticket ends
without a clear done/blocked signal — that needs a human look before
resuming; requeue/fix the issue and `./scripts/backlog stop && run` again.

Tickets live as GitHub issues on this repo, not on the local filesystem:
  queued   open issue,   label "backlog"
  done     closed issue, label "backlog"
  failed   open issue,   label "backlog:failed"

Each ticket runs in its own fresh `claude` session (the work-ticket skill).
git commit/push are not in the permission allow-list, so they always prompt
for approval — forward it to your phone with Remote Control (/rc) before
running `run` (unless you passed --yolo). Requires `gh` authenticated
against this repo.
EOF
}

ensure_dirs() {
  mkdir -p "$BACKLOG_DIR"
}

ensure_labels() {
  gh label create "$QUEUE_LABEL" --color "0E8A16" \
    --description "Backlog ticket queued for ./scripts/backlog" >/dev/null 2>&1 || true
  gh label create "$FAILED_LABEL" --color "B60205" \
    --description "Backlog ticket blocked, needs review before requeuing" >/dev/null 2>&1 || true
}

cmd_add() {
  ensure_labels
  local content
  if [[ "${1:-}" ]]; then
    content="$(cat "$1")"
  else
    content="$(cat)"
  fi
  [[ -n "$content" ]] || { echo "Ticket vacío, no se ha añadido." >&2; exit 1; }

  local title body
  title="$(head -n1 <<<"$content" | sed -E 's/^#+\s*//')"
  [[ -n "$title" ]] || { echo "El ticket no tiene título (primera línea vacía)." >&2; exit 1; }
  body="$(tail -n +2 <<<"$content" | sed -E '/./,$!d')"

  local url
  url="$(gh issue create --label "$QUEUE_LABEL" --title "$title" --body "${body:-$title}")"
  echo "Añadido: $url"
}

cmd_list() {
  echo "En cola:"
  gh issue list --label "$QUEUE_LABEL" --state open \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
  echo "Hechos:"
  gh issue list --label "$QUEUE_LABEL" --state closed \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
  echo "Fallidos/bloqueados:"
  gh issue list --label "$FAILED_LABEL" --state open \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
}

cmd_requeue() {
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "Uso: ./scripts/backlog requeue <número-de-issue>" >&2; exit 1; }
  gh issue edit "$n" --remove-label "$FAILED_LABEL" --add-label "$QUEUE_LABEL" >/dev/null
  echo "Reencolado: #$n"
}

POLL_INTERVAL="${BACKLOG_POLL_INTERVAL:-30}"

# Runs inside the worker tmux pane. Polls the queue forever, processing
# issues as they appear.
_worker() {
  local yolo=0
  [[ "${1:-}" == "--yolo" ]] && yolo=1

  ensure_dirs
  local claude_flags=()
  (( yolo )) && claude_flags+=(--dangerously-skip-permissions)

  echo "Escuchando issues con label '$QUEUE_LABEL' (cada ${POLL_INTERVAL}s). Ctrl-C o './scripts/backlog stop' para parar."
  while true; do
    if ! _process_queue "${claude_flags[@]}"; then
      echo "Worker detenido (revisión manual necesaria antes de reanudar)."
      return 1
    fi
    sleep "$POLL_INTERVAL"
  done
}

# Processes every currently queued issue once. Returns 1 if it hit a
# condition that needs human review before polling should resume.
_process_queue() {
  local claude_flags=("$@")
  local issues
  issues="$(gh issue list --label "$QUEUE_LABEL" --state open --json number --jq '.[].number' | sort -n)"
  if [[ -z "$issues" ]]; then
    return 0
  fi

  local n title body url seen=0 total=0
  total="$(wc -l <<<"$issues")"
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    # Otro proceso pudo haber reencolado/movido el issue entre tanto; re-verifica.
    if ! gh issue view "$n" --json state,labels \
        --jq 'select(.state=="OPEN" and (.labels|map(.name)|any(.=="'"$QUEUE_LABEL"'")))' \
        | grep -q .; then
      continue
    fi

    rm -f "$SIGNAL_FILE"
    title="$(gh issue view "$n" --json title --jq .title)"
    body="$(gh issue view "$n" --json body --jq '.body // ""')"
    url="$(gh issue view "$n" --json url --jq .url)"

    seen=$(( seen + 1 ))
    echo
    echo "=================================================="
    echo "Ticket: #$n $title"
    echo "=================================================="
    local prompt
    prompt="$(printf '/work-ticket\n\nGitHub issue: #%s (%s)\n\n%s\n\n%s' "$n" "$url" "$title" "$body")"
    claude "${claude_flags[@]}" "$prompt" || true

    if [[ -f "$SIGNAL_FILE" ]]; then
      local status reason
      status="$(sed -n 's/^status=//p' "$SIGNAL_FILE" | head -n1)"
      reason="$(sed -n 's/^reason=//p' "$SIGNAL_FILE" | head -n1)"
      case "$status" in
        done)
          # El skill ya ha dejado el resumen como comentario en el issue.
          gh issue close "$n" >/dev/null
          echo "-> hecho: #$n"
          ;;
        blocked)
          # El skill ya ha dejado el motivo como comentario en el issue.
          gh issue edit "$n" --remove-label "$QUEUE_LABEL" --add-label "$FAILED_LABEL" >/dev/null
          echo "-> bloqueado: #$n${reason:+ ($reason)}. Revisa y usa 'requeue $n' si procede."
          ;;
        *)
          echo "-> señal desconocida ('$status'), dejo #$n en cola para revisión manual."
          return 1
          ;;
      esac
      rm -f "$SIGNAL_FILE"
    else
      echo "-> la sesión terminó sin señal (salida manual/crash). Dejo #$n en cola y paro."
      return 1
    fi
  done <<<"$issues"
  echo
  echo "Pasada de cola completada. Vistos: $seen/$total tickets."
  return 0
}

# Runs inside the watcher tmux pane. Injects /exit into the worker pane once
# the skill signals it has finished, since a session can't end itself.
_watcher() {
  while true; do
    if [[ -f "$SIGNAL_FILE" ]]; then
      sleep 1
      tmux send-keys -t "${TMUX_SESSION}:0.0" "/exit" Enter
      while [[ -f "$SIGNAL_FILE" ]]; do sleep 1; done
    fi
    sleep 2
  done
}

cmd_run() {
  local yolo=0
  case "${1:-}" in
    --yolo) yolo=1 ;;
    "") ;;
    *) echo "Opción desconocida: $1" >&2; usage; exit 1 ;;
  esac

  ensure_dirs
  ensure_labels
  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "Ya hay una sesión '$TMUX_SESSION' corriendo. Conectando..."
    exec tmux attach -t "$TMUX_SESSION"
  fi
  local worker_cmd=("$0" __worker)
  (( yolo )) && worker_cmd+=(--yolo)
  tmux new-session -d -s "$TMUX_SESSION" -n main "${worker_cmd[@]}"
  tmux split-window -t "${TMUX_SESSION}:0" -v -l 3 "$0 __watcher"
  tmux select-pane -t "${TMUX_SESSION}:0.0"
  echo "Orquestador arrancado en tmux '$TMUX_SESSION'."
  if (( yolo )); then
    echo "--yolo activo: claude corre con --dangerously-skip-permissions, sin prompts."
  else
    echo "Recuerda tener /rc activo en la sesión de Claude para aprobar commit/push desde el móvil."
  fi
  exec tmux attach -t "$TMUX_SESSION"
}

cmd_stop() {
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null && echo "Sesión '$TMUX_SESSION' detenida." || echo "No había sesión corriendo."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  list) cmd_list ;;
  requeue) shift; cmd_requeue "$@" ;;
  run) shift; cmd_run "$@" ;;
  stop) cmd_stop ;;
  __worker) shift; _worker "$@" ;;
  __watcher) _watcher ;;
  -h|--help|"") usage ;;
  *) echo "Comando desconocido: $1" >&2; usage; exit 1 ;;
esac
