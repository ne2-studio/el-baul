#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: ./scripts/dsm <command>

Commands:
  approve   Regenerate the reviewed ElBaul.Core cross-feature dependency snapshot
            (api/ElBaul.Core.Tests/CoreDsm.snapshot.json) and the human-readable
            docs/architecture/core-dsm.md together, from the same graph, after reviewing the
            diff DsmApprovalTests reported (CoreDsm.snapshot.json vs. CoreDsm.received.json).
EOF
}

die() {
  printf 'dsm: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

run() {
  printf '\n==> %s\n' "$*"
  "$@"
}

ensure_root() {
  [[ -f "$ROOT_DIR/docker-compose.yaml" ]] || die "cannot locate repo root"
  [[ -f "$ROOT_DIR/api/ElBaul.Core.Tests/ElBaul.Core.Tests.csproj" ]] || die "cannot locate ElBaul.Core.Tests project"
}

approve() {
  need dotnet
  run env UPDATE_DSM_SNAPSHOT=1 dotnet test "$ROOT_DIR/api/ElBaul.Core.Tests/ElBaul.Core.Tests.csproj" \
    --filter "FullyQualifiedName~DsmApprovalTests"
}

ensure_root

case "${1:-}" in
  approve) approve ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; die "unknown command: $1" ;;
esac
