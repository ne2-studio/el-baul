#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
LABEL="gap-scout"
TMUX_SESSION="backlog"
ALLOWED_TOOLS="Bash(gh issue list *) Bash(gh issue create *) Bash(gh issue view *) Bash(gh label create *)"

usage() {
  cat <<'EOF'
Usage: ./scripts/gap-scout <command>

Commands:
  scan <app|api|both> [--yolo]
                        Dispatch the architecture-gap-scout skill over the
                          given scope(s), one interactive `claude` session
                          per scope, each in its own window inside the
                          "backlog" tmux session (creating it if needed) —
                          same session ./scripts/backlog run uses. Returns as
                          soon as the session(s) are launched; doesn't wait
                          for them to finish.
                          Each session dedupes against already-filed
                          initiatives and files new ones as GitHub issues
                          (label "gap-scout"). Read-only over the code; only
                          creates GitHub issues (and, once, the "gap-scout"
                          label).
                          If a scan is already running (its window still
                          exists), that scope is skipped instead of starting
                          a second overlapping session.

Runs interactively, not headless: without --yolo, a command outside the
narrow allow-list (only `gh issue`/`gh label`) pauses for approval in its
tmux window instead of hanging with no one able to answer — attach with
`tmux attach -t backlog` (or forward it to your phone with Remote Control) to
answer it. The inspection does a lot of ad-hoc shell pipelines (churn
analysis, grep/sed chains), so expect this fairly often.

--yolo runs claude with --dangerously-skip-permissions instead: no prompts
at all. Reasonable here specifically because gap-scout-runner never touches
git or edits code (unlike work-ticket's --yolo, which also skips the
commit/push approval) — the remaining exposure is unrestricted shell access
to a read-only inspection, not a write path. Still means no technical
safety net if something in the repo's content tried to steer the agent; use
it once you're comfortable leaving a scan fully unattended (e.g. from the
systemd timer).

Filed issues are not queued for execution by themselves. Review one, and if
you want it done, add the "backlog" label — that hands it to
./scripts/backlog's existing worker, same as any other ticket. Leaving it
unlabeled (or closing it) means "not now"; it won't be re-filed verbatim on
the next scan.

Requires `gh` and `tmux`. See docs/backlog/gap-scout.md for how to schedule
this with a systemd timer.
EOF
}

ensure_labels() {
  # "already exists" is fine and expected after the first run; anything else gets printed
  # instead of swallowed, so a real failure (auth, permissions) is visible in the logs.
  local err
  if ! err="$(gh label create "$LABEL" --color "5319E7" \
      --description "Architecture initiative proposed by gap-scout, pending approval" 2>&1 >/dev/null)"; then
    grep -qi "already exists" <<<"$err" || echo "aviso: no se pudo crear la label '$LABEL': $err" >&2
  fi
}

# Launches one scan as its own tmux window inside $TMUX_SESSION, creating the session if it
# doesn't exist yet. Skips it if a window for this scope is already running.
_dispatch_one() {
  local scope="$1"; shift
  local claude_flags=("$@")
  local window="gap-scout-${scope%/}"
  local prompt
  prompt="$(printf '/gap-scout-runner\n\nScope: %s\n' "$scope")"

  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    if tmux list-windows -t "$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$window"; then
      echo "aviso: la ventana tmux '$TMUX_SESSION:$window' ya existe (escaneo previo aún corriendo o sin cerrar); lo salto." >&2
      return 0
    fi
    tmux new-window -t "$TMUX_SESSION" -n "$window" claude "$prompt" "${claude_flags[@]}"
  else
    tmux new-session -d -s "$TMUX_SESSION" -n "$window" claude "$prompt" "${claude_flags[@]}"
  fi
  echo "Lanzado: $TMUX_SESSION:$window"
}

cmd_scan() {
  local target="${1:-}"
  local yolo=0
  case "${2:-}" in
    --yolo) yolo=1 ;;
    "") ;;
    *) echo "Uso: ./scripts/gap-scout scan <app|api|both> [--yolo]" >&2; exit 1 ;;
  esac
  case "$target" in
    app) ;;
    api) ;;
    both) ;;
    *) echo "Uso: ./scripts/gap-scout scan <app|api|both> [--yolo]" >&2; exit 1 ;;
  esac

  local claude_flags=()
  if (( yolo )); then
    claude_flags+=(--dangerously-skip-permissions)
  else
    claude_flags+=(--allowed-tools "$ALLOWED_TOOLS")
  fi

  ensure_labels
  case "$target" in
    app) _dispatch_one "app/" "${claude_flags[@]}" ;;
    api) _dispatch_one "api/" "${claude_flags[@]}" ;;
    both) _dispatch_one "app/" "${claude_flags[@]}"; _dispatch_one "api/" "${claude_flags[@]}" ;;
  esac
  echo "Adjunta con: tmux attach -t $TMUX_SESSION"
}

case "${1:-}" in
  scan) shift; cmd_scan "$@" ;;
  -h|--help|"") usage ;;
  *) echo "Comando desconocido: $1" >&2; usage; exit 1 ;;
esac
