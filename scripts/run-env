#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="$ROOT_DIR/.run"
LOG_DIR="$STATE_DIR/logs"
VITE_PID="$STATE_DIR/frontend-vite.pid"
BACKEND_PID="$STATE_DIR/backend-dev.pid"
VITE_LOG="$LOG_DIR/frontend-vite.log"
BACKEND_LOG="$LOG_DIR/backend-dev.log"

# Per-worktree identity: the main checkout keeps today's fixed project name and ports
# (so this stays a no-op for the common case). A linked `git worktree` gets a
# deterministic offset derived from its absolute path, so `run-env` invocations from
# different worktrees never collide on Compose project name, container/volume names,
# published host ports, or built image tags — see compute_worktree_context below.
#
# WORKTREE_OFFSET is added to every fixed port; WORKTREE_SUFFIX (empty for the main
# checkout) names the Compose project and image tags.
compute_worktree_context() {
  local git_dir git_common_dir toplevel hash_hex hash_num

  WORKTREE_OFFSET=0
  WORKTREE_SUFFIX=""

  git_dir="$(git -C "$ROOT_DIR" rev-parse --git-dir 2>/dev/null)" || return 0
  git_common_dir="$(git -C "$ROOT_DIR" rev-parse --git-common-dir 2>/dev/null)" || return 0
  toplevel="$(git -C "$ROOT_DIR" rev-parse --show-toplevel 2>/dev/null)" || return 0

  # rev-parse's --git-dir/--git-common-dir can be relative to ROOT_DIR; resolve both
  # to absolute paths before comparing.
  git_dir="$(cd "$ROOT_DIR" && cd "$git_dir" && pwd)"
  git_common_dir="$(cd "$ROOT_DIR" && cd "$git_common_dir" && pwd)"

  # Same git-dir and common-dir means this checkout IS the main worktree (a linked
  # worktree's git-dir always lives under the main checkout's .git/worktrees/<name>,
  # distinct from the shared common-dir) — keep the historical fixed defaults so CI,
  # e2e-tests, and plain `docker compose up` stay byte-for-byte unaffected.
  [[ "$git_dir" == "$git_common_dir" ]] && return 0

  hash_hex="$(printf '%s' "$toplevel" | sha1sum | cut -c1-10)"
  hash_num=$((16#$hash_hex))
  # Offset step of 10, never 0, spread over 5000 slots: keeps every derived port well
  # under 65535 (max fixed port 9001 + max offset 50000 < 65535) while keeping
  # cross-worktree collisions unlikely for a realistic number of concurrent worktrees.
  # A collision (two worktrees landing on the same offset) is still handled safely: it
  # surfaces as an ordinary "port already in use" failure from require_port_free*,
  # exactly like any other conflicting process would.
  WORKTREE_OFFSET=$(( (hash_num % 5000 + 1) * 10 ))
  WORKTREE_SUFFIX="$(printf '%s' "$toplevel" | sha1sum | cut -c1-8)"
}

compute_worktree_context

PG_PORT=$((5432 + WORKTREE_OFFSET))
MINIO_PORT=$((9000 + WORKTREE_OFFSET))
MINIO_CONSOLE_PORT=$((9001 + WORKTREE_OFFSET))
IMGPROXY_PORT=$((8081 + WORKTREE_OFFSET))
FAKE_OIDC_PORT=$((5000 + WORKTREE_OFFSET))
MAILPIT_UI_PORT=$((8025 + WORKTREE_OFFSET))
MAILPIT_SMTP_PORT=$((1025 + WORKTREE_OFFSET))
BACKEND_PORT=$((5050 + WORKTREE_OFFSET))
API_LITE_PORT=$((5051 + WORKTREE_OFFSET))
APP_PORT=$((3000 + WORKTREE_OFFSET))
ADMIN_PORT=$((3001 + WORKTREE_OFFSET))
VITE_PORT=$((5173 + WORKTREE_OFFSET))

if [[ -n "$WORKTREE_SUFFIX" ]]; then
  COMPOSE_PROJECT="el-baul-$WORKTREE_SUFFIX"
  IMAGE_TAG_SUFFIX="-$WORKTREE_SUFFIX"
else
  COMPOSE_PROJECT="el-baul"
  IMAGE_TAG_SUFFIX=""
fi
COMPOSE_PROJECT_LITE="${COMPOSE_PROJECT}-lite"

# Export so every `docker compose`/`dotnet run`/`npm run dev` invocation below (and
# any env var interpolation inside the compose files themselves) sees the same
# per-worktree values.
export PG_PORT MINIO_PORT MINIO_CONSOLE_PORT IMGPROXY_PORT FAKE_OIDC_PORT \
  MAILPIT_UI_PORT MAILPIT_SMTP_PORT BACKEND_PORT API_LITE_PORT APP_PORT ADMIN_PORT VITE_PORT

API_LITE_IMAGE="${API_LITE_IMAGE:-el-baul-api-lite:run-dev$IMAGE_TAG_SUFFIX}"

compose_main() {
  docker compose -p "$COMPOSE_PROJECT" -f "$ROOT_DIR/docker-compose.yaml" "$@"
}

compose_lite() {
  docker compose -p "$COMPOSE_PROJECT_LITE" -f "$ROOT_DIR/docker-compose.lite.yml" "$@"
}

usage() {
  cat <<EOF
Usage: ./scripts/run-env <command>

Commands:
  frontend-dev   fake-oidc + api-lite in Docker, app from Vite on port $VITE_PORT.
  backend-dev    dependencies in Docker, backend from local dotnet on port $BACKEND_PORT.
  full-stack     compose-built API, app, admin, and dependencies in Docker.
  logs [mode] [component]
                 show recent logs for a mode, optionally narrowed to a component.
  cleanup        stop local dev processes and the compose stack started by this
                 helper for the CURRENT worktree only — other worktrees' run-env
                 environments are left running.

This is worktree-aware: the main checkout uses the fixed ports/Compose project
below; a linked git worktree gets its own deterministic port offset and Compose
project ($COMPOSE_PROJECT here), so multiple worktrees can run any combination of
modes at once without colliding.
EOF
}

die() {
  printf 'run-env: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

ensure_dirs() {
  mkdir -p "$LOG_DIR"
}

port_in_use() {
  local port="$1"

  if docker ps --format '{{.Names}} {{.Ports}}' | grep -Eq "(^|[ ,])([0-9.]+:|\\[::\\]:)?$port->"; then
    return 0
  fi

  if command -v ss >/dev/null 2>&1 && ss -ltn | awk '{print $4}' | grep -Eq "(:|\\])$port$"; then
    return 0
  fi

  return 1
}

docker_port_owned_by() {
  local port="$1"
  shift
  local name

  for name in "$@"; do
    if docker ps --format '{{.Names}} {{.Ports}}' |
      grep -F "$name" |
      grep -Eq "(^|[ ,])([0-9.]+:|\\[::\\]:)?$port->"; then
      return 0
    fi
  done

  return 1
}

require_port_free() {
  local port="$1"
  local purpose="$2"

  if port_in_use "$port"; then
    die "$purpose port $port is already in use; run './scripts/run-env cleanup' or report the conflicting user process"
  fi
}

require_port_free_unless_owned() {
  local port="$1"
  local purpose="$2"
  shift 2

  if port_in_use "$port" && ! docker_port_owned_by "$port" "$@"; then
    die "$purpose port $port is already in use by an unexpected process; run './scripts/run-env cleanup' or report the conflict"
  fi
}

pid_alive() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

stop_pid() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 0

  local pid
  pid="$(cat "$pid_file")"
  if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
    kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      kill -0 "$pid" >/dev/null 2>&1 || break
      sleep 0.2
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$pid_file"
}

wait_http() {
  local url="$1"
  local timeout_seconds="$2"
  local label="$3"
  local deadline=$((SECONDS + timeout_seconds))

  until curl -fs --max-time 2 "$url" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      die "$label did not become ready at $url within ${timeout_seconds}s"
    fi
    sleep 1
  done
}

ensure_npm_deps() {
  local dir="$1"
  local node_modules="$ROOT_DIR/$dir/node_modules"
  local hidden_lock="$node_modules/.package-lock.json"

  if [[ ! -d "$node_modules" || ! -f "$hidden_lock" || "$ROOT_DIR/$dir/package-lock.json" -nt "$hidden_lock" ]]; then
    (cd "$ROOT_DIR/$dir" && npm ci)
  fi
}

reconcile_frontend_dev() {
  stop_pid "$BACKEND_PID"
  compose_main down --remove-orphans >/dev/null 2>&1 || true
}

reconcile_backend_dev() {
  stop_pid "$VITE_PID"
  compose_lite down --remove-orphans >/dev/null 2>&1 || true
  compose_main stop api app admin >/dev/null 2>&1 || true
  compose_main rm -f api app admin >/dev/null 2>&1 || true
}

reconcile_full_stack() {
  stop_pid "$VITE_PID"
  stop_pid "$BACKEND_PID"
  compose_lite down --remove-orphans >/dev/null 2>&1 || true
}

print_worktree_note() {
  if [[ -n "$WORKTREE_SUFFIX" ]]; then
    cat <<EOF
Worktree: $ROOT_DIR (linked worktree, Compose project $COMPOSE_PROJECT, port offset +$WORKTREE_OFFSET)
Token for this worktree: FAKE_OIDC_URL="http://localhost:$FAKE_OIDC_PORT" ./scripts/fake-oidc-token <user>
EOF
  else
    cat <<EOF
Worktree: $ROOT_DIR (main checkout, Compose project $COMPOSE_PROJECT)
EOF
  fi
}

print_frontend_dev() {
  cat <<EOF
Mode: frontend-dev
Frontend: http://localhost:$VITE_PORT
Backend: http://localhost:$API_LITE_PORT
Frontend source: Vite app/ source with hot reload
Backend source: Docker image $API_LITE_IMAGE
Docker components: fake-oidc, api-lite
Development components: app Vite dev server
Health: ready
Test user: fake-oidc admin -> admin-user (Admin User); user -> normal-user (Normal User)
$(print_worktree_note)Logs:
  all: ./scripts/run-env logs frontend-dev
  frontend: ./scripts/run-env logs frontend-dev frontend
  backend: ./scripts/run-env logs frontend-dev backend
  auth: ./scripts/run-env logs frontend-dev auth
Cleanup: ./scripts/run-env cleanup (this worktree only)
EOF
}

print_backend_dev() {
  cat <<EOF
Mode: backend-dev
Frontend: none
Backend: http://localhost:$BACKEND_PORT
Frontend source: none
Backend source: local api/ElBaul.Api via dotnet run
Docker components: postgres, minio, imgproxy, fake-oidc, mailpit
Development components: backend
Health: ready
Test user: fake-oidc admin -> admin-user (Admin User); user -> normal-user (Normal User)
$(print_worktree_note)Logs:
  all: ./scripts/run-env logs backend-dev
  backend: ./scripts/run-env logs backend-dev backend
  infra: ./scripts/run-env logs backend-dev infra
  auth: ./scripts/run-env logs backend-dev auth
Cleanup: ./scripts/run-env cleanup (this worktree only)
EOF
}

print_full_stack() {
  cat <<EOF
Mode: full-stack
Frontend: http://localhost:$APP_PORT
Backend: http://localhost:$BACKEND_PORT
Admin: http://localhost:$ADMIN_PORT
Frontend source: Docker image built from app/
Backend source: Docker image built from api/
Docker components: postgres, minio, imgproxy, fake-oidc, mailpit, api, app, admin
Development components: none
Health: ready
Test user: fake-oidc admin -> admin-user (Admin User); user -> normal-user (Normal User)
$(print_worktree_note)Logs:
  all: ./scripts/run-env logs full-stack
  frontend: ./scripts/run-env logs full-stack frontend
  backend: ./scripts/run-env logs full-stack backend
  admin: ./scripts/run-env logs full-stack admin
  infra: ./scripts/run-env logs full-stack infra
Cleanup: ./scripts/run-env cleanup (this worktree only)
EOF
}

frontend_dev() {
  need docker
  need npm
  need curl
  ensure_dirs
  reconcile_frontend_dev

  require_port_free "$APP_PORT" "Docker frontend"
  require_port_free_unless_owned "$FAKE_OIDC_PORT" "fake-oidc" "${COMPOSE_PROJECT_LITE}-fake-oidc-1"
  require_port_free_unless_owned "$API_LITE_PORT" "api-lite" "${COMPOSE_PROJECT_LITE}-api-lite-1"

  if ! pid_alive "$VITE_PID"; then
    require_port_free "$VITE_PORT" "Vite frontend"
  fi

  docker build -f "$ROOT_DIR/api/ElBaul.Api.Lite/Dockerfile" -t "$API_LITE_IMAGE" "$ROOT_DIR/api"
  API_LITE_IMAGE="$API_LITE_IMAGE" compose_lite up -d fake-oidc api-lite

  wait_http "http://localhost:$FAKE_OIDC_PORT/.well-known/jwks.json" 120 "fake-oidc"
  wait_http "http://localhost:$API_LITE_PORT/health" 120 "api-lite"

  ensure_npm_deps app
  if ! pid_alive "$VITE_PID"; then
    (
      cd "$ROOT_DIR/app"
      nohup env \
        VITE_API_URL="http://localhost:$API_LITE_PORT" \
        VITE_OIDC_AUTHORITY="http://localhost:$FAKE_OIDC_PORT" \
        VITE_OIDC_CLIENT_ID="el-baul-app" \
        VITE_OIDC_CALLBACK_URI="http://localhost:$VITE_PORT/callback" \
        npm run dev -- --port "$VITE_PORT" >"$VITE_LOG" 2>&1 &
      echo $! >"$VITE_PID"
    )
  fi

  wait_http "http://localhost:$VITE_PORT" 60 "Vite frontend"
  print_frontend_dev
}

backend_dev() {
  need docker
  need dotnet
  need curl
  ensure_dirs
  reconcile_backend_dev

  require_port_free "$APP_PORT" "Docker frontend"
  require_port_free "$ADMIN_PORT" "Docker admin"
  require_port_free_unless_owned "$FAKE_OIDC_PORT" "fake-oidc" "${COMPOSE_PROJECT}-fake-oidc-1"
  require_port_free_unless_owned "$PG_PORT" "postgres" "${COMPOSE_PROJECT}-postgres-1"
  require_port_free_unless_owned "$MINIO_PORT" "minio" "${COMPOSE_PROJECT}-minio-1"
  require_port_free_unless_owned "$MINIO_CONSOLE_PORT" "minio console" "${COMPOSE_PROJECT}-minio-1"
  require_port_free_unless_owned "$IMGPROXY_PORT" "imgproxy" "${COMPOSE_PROJECT}-imgproxy-1"
  require_port_free_unless_owned "$MAILPIT_UI_PORT" "mailpit UI" "${COMPOSE_PROJECT}-mailpit-1"
  require_port_free_unless_owned "$MAILPIT_SMTP_PORT" "mailpit SMTP" "${COMPOSE_PROJECT}-mailpit-1"

  if ! pid_alive "$BACKEND_PID"; then
    require_port_free "$BACKEND_PORT" "backend"
  fi

  compose_main up --build -d postgres minio imgproxy fake-oidc mailpit
  wait_http "http://localhost:$FAKE_OIDC_PORT/.well-known/jwks.json" 120 "fake-oidc"

  if ! pid_alive "$BACKEND_PID"; then
    (
      cd "$ROOT_DIR/api"
      nohup env ASPNETCORE_ENVIRONMENT=Development \
        ASPNETCORE_URLS="http://localhost:$BACKEND_PORT" \
        ConnectionStrings__DefaultConnection="Host=localhost;Port=$PG_PORT;Database=elbaul;Username=devuser;Password=devpass" \
        Auth__JwksUri="http://localhost:$FAKE_OIDC_PORT/.well-known/jwks.json" \
        Auth__ValidIssuer="http://localhost:$FAKE_OIDC_PORT" \
        Auth__UserInfoEndpoint="http://localhost:$FAKE_OIDC_PORT/oidc/v1/userinfo" \
        Storage__Endpoint="http://localhost:$MINIO_PORT" \
        Imgproxy__BaseUrl="http://localhost:$IMGPROXY_PORT" \
        Api__PublicUrl="http://localhost:$BACKEND_PORT" \
        ExternalTools__Hangfire="http://localhost:$BACKEND_PORT/hangfire" \
        ExternalTools__MinioConsole="http://localhost:$MINIO_CONSOLE_PORT" \
        dotnet run --no-launch-profile --project ElBaul.Api/ElBaul.Api.csproj >"$BACKEND_LOG" 2>&1 &
      echo $! >"$BACKEND_PID"
    )
  fi

  wait_http "http://localhost:$BACKEND_PORT/health" 120 "backend"
  print_backend_dev
}

full_stack() {
  need docker
  need curl
  ensure_dirs
  reconcile_full_stack

  if port_in_use "$VITE_PORT" && ! pid_alive "$VITE_PID"; then
    die "Vite frontend port $VITE_PORT is already in use; full-stack must not leave a second frontend running"
  fi
  if pid_alive "$VITE_PID"; then
    die "Vite frontend from run-env is running; use './scripts/run-env cleanup' before full-stack"
  fi

  require_port_free_unless_owned "$APP_PORT" "Docker frontend" "${COMPOSE_PROJECT}-app-1"
  require_port_free_unless_owned "$ADMIN_PORT" "Docker admin" "${COMPOSE_PROJECT}-admin-1"
  require_port_free_unless_owned "$BACKEND_PORT" "backend" "${COMPOSE_PROJECT}-api-1"
  require_port_free_unless_owned "$FAKE_OIDC_PORT" "fake-oidc" "${COMPOSE_PROJECT}-fake-oidc-1"
  require_port_free_unless_owned "$PG_PORT" "postgres" "${COMPOSE_PROJECT}-postgres-1"
  require_port_free_unless_owned "$MINIO_PORT" "minio" "${COMPOSE_PROJECT}-minio-1"
  require_port_free_unless_owned "$MINIO_CONSOLE_PORT" "minio console" "${COMPOSE_PROJECT}-minio-1"
  require_port_free_unless_owned "$IMGPROXY_PORT" "imgproxy" "${COMPOSE_PROJECT}-imgproxy-1"
  require_port_free_unless_owned "$MAILPIT_UI_PORT" "mailpit UI" "${COMPOSE_PROJECT}-mailpit-1"
  require_port_free_unless_owned "$MAILPIT_SMTP_PORT" "mailpit SMTP" "${COMPOSE_PROJECT}-mailpit-1"

  compose_main up --build -d postgres minio imgproxy fake-oidc mailpit api app admin
  wait_http "http://localhost:$FAKE_OIDC_PORT/.well-known/jwks.json" 120 "fake-oidc"
  wait_http "http://localhost:$BACKEND_PORT/health" 120 "backend"
  wait_http "http://localhost:$APP_PORT" 120 "frontend"
  wait_http "http://localhost:$ADMIN_PORT" 120 "admin"
  print_full_stack
}

logs() {
  local mode="${1:-}"
  local component="${2:-all}"
  case "$mode" in
    frontend-dev)
      case "$component" in
        all)
          [[ -f "$VITE_LOG" ]] && tail -80 "$VITE_LOG" || true
          compose_lite logs --tail=80 fake-oidc api-lite
          ;;
        frontend) [[ -f "$VITE_LOG" ]] && tail -120 "$VITE_LOG" || true ;;
        backend) compose_lite logs --tail=120 api-lite ;;
        auth) compose_lite logs --tail=120 fake-oidc ;;
        *) die "unknown frontend-dev log component: $component" ;;
      esac
      ;;
    backend-dev)
      case "$component" in
        all)
          [[ -f "$BACKEND_LOG" ]] && tail -120 "$BACKEND_LOG" || true
          compose_main logs --tail=80 postgres minio imgproxy fake-oidc mailpit
          ;;
        backend) [[ -f "$BACKEND_LOG" ]] && tail -160 "$BACKEND_LOG" || true ;;
        infra) compose_main logs --tail=120 postgres minio imgproxy mailpit ;;
        auth) compose_main logs --tail=120 fake-oidc ;;
        *) die "unknown backend-dev log component: $component" ;;
      esac
      ;;
    full-stack)
      case "$component" in
        all) compose_main logs --tail=120 postgres minio imgproxy fake-oidc mailpit api app admin ;;
        frontend) compose_main logs --tail=160 app ;;
        backend) compose_main logs --tail=160 api ;;
        admin) compose_main logs --tail=160 admin ;;
        infra) compose_main logs --tail=120 postgres minio imgproxy fake-oidc mailpit ;;
        *) die "unknown full-stack log component: $component" ;;
      esac
      ;;
    *)
      die "usage: ./scripts/run-env logs <frontend-dev|backend-dev|full-stack> [component]"
      ;;
  esac
}

cleanup() {
  ensure_dirs
  stop_pid "$VITE_PID"
  stop_pid "$BACKEND_PID"
  compose_lite down --remove-orphans >/dev/null 2>&1 || true
  compose_main down --remove-orphans >/dev/null 2>&1 || true
  echo "Cleanup: stopped run-env processes and the $COMPOSE_PROJECT / $COMPOSE_PROJECT_LITE compose stacks for this worktree ($ROOT_DIR) only; named volumes were kept. Other worktrees' run-env environments, if any, were left running."
}

case "${1:-}" in
  frontend-dev) frontend_dev ;;
  backend-dev) backend_dev ;;
  full-stack) full_stack ;;
  logs) shift; logs "${1:-}" "${2:-all}" ;;
  cleanup) cleanup ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; die "unknown command: $1" ;;
esac
