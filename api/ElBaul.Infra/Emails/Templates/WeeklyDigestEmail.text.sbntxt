- {{ block.label }}: {{ block.deep_link_url }}
{{~ end ~}}
{{~ if section.overflow_summary ~}}
- {{ section.overflow_summary }}
{{~ end ~}}
{{~ end ~}}
{{~ else if has_baules ~}}
