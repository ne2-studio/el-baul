{{~ capture subject ~}}Bienvenido a El Baúl{{~ end ~}}
{{~ user_name_t = truncate user_name 100 ~}}
{{~ intro = "Aún no perteneces a ningún baúl, pero eso tiene fácil arreglo." ~}}
{{~ body_text = "Un baúl es el espacio donde tu familia guarda sus fotos y recuerdos. Crea el tuyo para empezar." ~}}
{{~ capture content ~}}
<p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">Hola {{ user_name_t | html.escape }},</p>
<p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">{{ intro | html.escape }}</p>
<p style="margin:0 0 24px 0;font-size:16px;line-height:1.5;">{{ body_text | html.escape }}</p>
{{ include "Button.html" url: primary_cta_url label: primary_cta_label }}
{{~ end ~}}
{{ include "Layout.html" }}
