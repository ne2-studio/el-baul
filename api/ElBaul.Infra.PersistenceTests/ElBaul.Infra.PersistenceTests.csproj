<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately excluded from ElBaul.slnx: this project needs a running Docker daemon (a real
    Postgres via Testcontainers), which `./scripts/verify backend` / plain `dotnet test
    ElBaul.slnx` promise NOT to require. Run it explicitly via `./scripts/verify
    backend-persistence`. See README.md for what this project is for and, as importantly, what
    it deliberately doesn't try to cover.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElBaul.Infra\ElBaul.Infra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ElBaul.ReadModelContractTests\ListReadModelContractScenarios.cs" Link="ReadModelContractTests\ListReadModelContractScenarios.cs" />
  </ItemGroup>

</Project>
